# Copy this file to backend/.env and fill in what you need. Every variable here
# is OPTIONAL — the backend runs with none of them set.
#
# SERVER-SIDE ONLY. Nothing in this file may ever be re-declared as a VITE_
# variable in frontend/.env: Vite inlines every such value into the client
# bundle, so naming a secret that way publishes it to every visitor.

# AI-drafted brand kit (ORG-04). Leave this unset and the draft endpoint answers
# 503 ai_unavailable, while every other feature — profile, logo, social links and
# the manual brand-kit editor — works exactly as normal. Get a key from
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model used for the brand-kit draft. Default when unset: gemini-2.5-flash
GEMINI_MODEL=


# --- Venue autocomplete (Mappls Autosuggest) ---
# OAuth2 client-credentials pair from https://apis.mappls.com/console/
# NOT the "REST API key". Both required; one alone counts as unset.
MAPPLS_CLIENT_ID=
MAPPLS_CLIENT_SECRET=
